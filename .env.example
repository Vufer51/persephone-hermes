# Persephone Music — шаблон конфигурации
#
# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
#
# ВАЖНО:
# - .env не коммитится в Git;
# - значения ниже — заглушки, а не рабочие секреты;
# - приложение пока не читает эти переменные: конфигурация появится
#   в задачах #6 и #2 (https://github.com/DrRocksoDevelopment/persephone/issues).

# --- Общее ---
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=persephone
POSTGRES_USER=persephone
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://persephone:change-me@postgres:5432/persephone
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Секреты приложения ---
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=change-me-session-secret
# 32 байта в base64. Сгенерировать: openssl rand -base64 32
# Используется для шифрования Last.fm session keys. Не совпадает с SESSION_SECRET.
SECRET_ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Navidrome ---
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# --- Lidarr ---
# Можно указать существующий экземпляр вместо развёртывания дубликата.
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=

# --- MusicBrainz ---
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# Обязательный User-Agent с названием проекта и контактом.
MUSICBRAINZ_USER_AGENT=PersephoneMusic/0.1 (https://github.com/DrRocksoDevelopment/persephone)

# --- Last.fm ---
# Общий ключ приложения. Пользовательские session keys хранятся в БД в зашифрованном виде.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/

# --- Музыкальные файлы ---
# Путь на хосте и точка монтирования в контейнере.
# В бизнес-логике используются storage_roots + relative_path, а не эти пути напрямую.
MUSIC_ROOT_HOST=./data/music
MUSIC_ROOT_CONTAINER=/music
