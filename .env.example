# Persephone Music — шаблон конфигурации
#
# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
#
# ВАЖНО:
# - .env не коммитится в Git;
# - значения-заглушки необходимо заменить;
# - приложение читает переменные окружения, а не сам файл .env.
#   Docker Compose загружает .env автоматически, локальные npm-скрипты —
#   через node --env-file-if-exists=../.env.

# --- Общее ---
NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=persephone
POSTGRES_USER=persephone
# Обязательно замените. Compose не запустится с пустым паролем.
POSTGRES_PASSWORD=
# Порт публикуется только в docker-compose.dev.yml на 127.0.0.1.
POSTGRES_PORT=5432
# Для локального запуска вне Docker. Пароль должен совпадать с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://persephone:CHANGE_ME@127.0.0.1:5432/persephone
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
# Порт публикуется только в docker-compose.dev.yml на 127.0.0.1.
REDIS_PORT=6379

# --- Секреты приложения ---
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=
# Ровно 32 байта в base64. Сгенерировать: openssl rand -base64 32
# Используется для шифрования Last.fm session keys.
# Не должен совпадать с SESSION_SECRET.
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=1

# --- Музыкальные файлы ---
# Путь на хосте и точка монтирования в контейнере.
# В бизнес-логике используются storage_roots + relative_path, а не эти пути напрямую.
MUSIC_ROOT_HOST=./data/music
MUSIC_ROOT_CONTAINER=/music
STORAGE_ROOT_NAME=local-music
STORAGE_ROOT_IDENTIFIER=local-music

# --- Navidrome ---
# Пустое значение: внутри Compose используется http://navidrome:4533.
# Для запуска API вне Docker укажите http://127.0.0.1:4533.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_PORT=4533
NAVIDROME_LOG_LEVEL=info
NAVIDROME_SCAN_SCHEDULE=1h

# --- Lidarr ---
# Пустое значение: внутри Compose используется http://lidarr:8686.
# Для запуска API вне Docker укажите http://127.0.0.1:8686.
# Можно указать существующий экземпляр Lidarr вместо развёртывания дубликата.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_PORT=8686
LIDARR_DOWNLOADS_HOST=./data/downloads

# --- MusicBrainz ---
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# Обязательный User-Agent с названием проекта и контактом.
MUSICBRAINZ_USER_AGENT=PersephoneMusic/0.1 (+https://github.com/DrRocksoDevelopment/persephone)

# --- Last.fm ---
# Общий ключ приложения. Пользовательские session keys хранятся в БД в зашифрованном виде.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0/

# --- LinuxServer / Lidarr ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Тестовая база (необязательно) ---
# Нужна для интеграционных тестов миграций. Имя базы должно оканчиваться на _test.
# TEST_DATABASE_URL=postgresql://persephone:CHANGE_ME@127.0.0.1:5432/persephone_test
